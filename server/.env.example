NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://localhost:27017/icar_storage

JWT_SECRET=change_this_jwt_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

DEVICE_API_KEY=change_this_shared_device_key

DEVICE_OFFLINE_TIMEOUT_SECONDS=60
DEVICE_STATUS_SWEEP_INTERVAL_SECONDS=30
RELAY_COMMAND_TIMEOUT_MS=30000

ALERT_TEMP_HIGH_C=35
ALERT_HUMIDITY_HIGH_PERCENT=85
ALERT_CO2_HIGH_PPM=1500

SENSOR_DATA_RETENTION_DAYS=30
RETENTION_CLEANUP_CRON=0 3 * * *

TEMP_MIN_C=-40
TEMP_MAX_C=125
HUMIDITY_MIN_PERCENT=0
HUMIDITY_MAX_PERCENT=100
CO2_MIN_PPM=0
CO2_MAX_PPM=10000
PRESSURE_MIN_HPA=300
PRESSURE_MAX_HPA=1100

CORS_ORIGIN=*

LOG_LEVEL=info
