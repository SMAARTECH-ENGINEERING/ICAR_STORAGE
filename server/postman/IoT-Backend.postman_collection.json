                  "pm.test('Response data is an array', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data).to.be.an('array');",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "if (json.data && json.data.length > 0) {",
                  "    pm.test('First alert ID saved to alertId variable', function () {",
