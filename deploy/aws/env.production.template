# Non-secret production config — safe to commit. Real secrets (MONGODB_URI,
# JWT_SECRET, JWT_REFRESH_SECRET, DEVICE_API_KEY) are NOT here; they're
# fetched from SSM Parameter Store by fetch-ssm-env.sh and appended at
# deploy time to produce the final .env used by docker-compose.prod.yml.
NODE_ENV=production
PORT=5000

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DEVICE_OFFLINE_TIMEOUT_SECONDS=60
DEVICE_STATUS_SWEEP_INTERVAL_SECONDS=30
RELAY_COMMAND_TIMEOUT_MS=30000

ALERT_TEMP_HIGH_C=35
ALERT_HUMIDITY_HIGH_PERCENT=85
ALERT_CO2_HIGH_PPM=1500

SENSOR_DATA_RETENTION_DAYS=30
RETENTION_CLEANUP_CRON=0 3 * * *

# Set this to your CloudFront domain, e.g. https://d123abc.cloudfront.net
CORS_ORIGIN=<CLOUDFRONT_DOMAIN>

LOG_LEVEL=info
